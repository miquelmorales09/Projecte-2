# Demanem dos nombres enters
num1 = int(input("Introdueix el primer nombre enter: "))
num2 = int(input("Introdueix el segon nombre enter: "))

# Calculem les operacions
suma = num1 + num2
resta = num1 - num2
multiplicacio = num1 * num2

# Comprovem si el segon nombre és 0 per evitar l'error de divisió per zero
if num2 != 0:
    divisio = num1 / num2
else:
    divisio = "No es pot dividir per zero"

# Impressió dels resultats
print(f"Suma: {suma}")
print(f"Resta: {resta}")
print(f"Multiplicació: {multiplicacio}")
print(f"Divisió: {divisio}")